{
  "$schema": "https://json.schemastore.org/package.json",
  "version": "2.0.2",
  "name": "@flat6/opengit",
  "description": "A CLI tool for managing Git",
  "type": "module",
  "private": true,
  "bin": {
    "opengit": "bin/opengit"
  },
  "scripts": {
    "dev": "bun run --watch src/index.tsx",
    "build": "bun run scripts/build.ts"
  },
  "devDependencies": {
    "@tsconfig/bun": "latest",
    "@types/bun": "latest",
    "prettier": "3.6.2"
  },
  "dependencies": {
    "@opencode-ai/sdk": "^1.18.4",
    "@opentui/core": "^0.4.5",
    "@opentui/solid": "^0.4.5",
    "clipboardy": "^5.0.2",
    "fuzzysort": "^3.1.0",
    "opentui-spinner": "^0.0.6",
    "remeda": "^2.33.4",
    "solid-js": "^1.9.10",
    "xdg-basedir": "^5.1.0",
    "zod": "^4.3.6"
  },
  "prettier": {
    "semi": false,
    "printWidth": 120,
    "singleQuote": false
  }
}
